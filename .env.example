# Copy this file to .env and paste your key below.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional — voice. Without these Mr. Meter still works, just silently.
# Key: https://elevenlabs.io/app/settings/api-keys
# Voice ID: pick a voice at https://elevenlabs.io/app/voices and copy its ID
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional — painted backgrounds for the downloaded card. Without it the card
# falls back to the drawn (SVG) backgrounds. Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
